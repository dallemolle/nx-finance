// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  password           String
  status_2fa         Boolean                 @default(false)
  secret_2fa         String?
  transactions       Transaction[]
  categories         Category[]
  paymentMethods     PaymentMethod[]
  institutions       FinancialInstitution[]
  mappingSuggestions MappingSuggestion[]
  creditCards        CreditCard[]
  recoveryCodes      TwoFactorRecoveryCode[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

// Códigos de recuperação do 2FA (BL-021): uso único, guardados só como hash
// SHA-256 (o código tem 50 bits aleatórios, então hash rápido basta — não é
// uma senha escolhida pelo usuário). usedAt marca o uso; gerar novos apaga os antigos.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Tentativas de login que falharam (BL-036), pra limitar força bruta de senha
// e do código do 2FA. key = "email:<email>" ou "ip:<ip>". No banco (não em
// memória) porque na Vercel cada requisição pode cair numa instância diferente.
model LoginFailure {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum TransactionStatus {
  PENDENTE
  PAGO
  ATRASADO
}

enum TransactionType {
  ENTRADA
  SAIDA
}

model Transaction {
  id                String            @id @default(cuid())
  descricao         String
  valor             Decimal           @db.Decimal(10, 2)
  data_lancamento   DateTime          @default(now())
  data_vencimento   DateTime
  data_pagamento    DateTime?
  status            TransactionStatus @default(PENDENTE)
  tipo              TransactionType
  is_invoice_header Boolean           @default(false)
  is_provisioned    Boolean           @default(false)
  invoice_month     Int?
  invoice_year      Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoria_id String
  category     Category @relation(fields: [categoria_id], references: [id])

  tipo_pagamento_id String
  paymentMethod     PaymentMethod @relation(fields: [tipo_pagamento_id], references: [id])

  institution_id String
  institution    FinancialInstitution @relation(fields: [institution_id], references: [id])

  credit_card_id String?
  creditCard     CreditCard? @relation(fields: [credit_card_id], references: [id])

  invoiceItems CreditCardInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, data_vencimento])
  @@index([userId, credit_card_id, invoice_month, invoice_year])
}

model CreditCardInvoiceItem {
  id                       String    @id @default(cuid())
  descricao                String
  valor                    Decimal   @db.Decimal(10, 2)
  data_compra              DateTime
  data_vencimento_original DateTime?
  is_provisioned           Boolean   @default(false)
  installment_group_id     String?
  installment_number       Int?
  installment_total        Int?

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  categoria_id String
  category     Category @relation(fields: [categoria_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installment_group_id])
}

model Category {
  id    String          @id @default(cuid())
  nome  String
  cor   String
  icone String
  tipo  TransactionType

  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions           Transaction[]
  mappingSuggestions     MappingSuggestion[]
  creditCardInvoiceItems CreditCardInvoiceItem[]

  @@unique([nome, userId, tipo])
}

model PaymentMethod {
  id   String @id @default(cuid())
  nome String

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([nome, userId])
}

model MappingSuggestion {
  id          String @id @default(cuid())
  search_term String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoria_id String
  category     Category @relation(fields: [categoria_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([search_term, userId])
}

model FinancialInstitution {
  id       String  @id @default(cuid())
  nome     String
  cor      String?
  metadata Json?   @default("{}")

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  creditCards  CreditCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, userId])
}

model CreditCard {
  id         String   @id @default(cuid())
  nome       String
  closingDay Int
  dueDay     Int
  limite     Decimal? @db.Decimal(10, 2)
  cor        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  institution_id String
  institution    FinancialInstitution @relation(fields: [institution_id], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, userId])
}
